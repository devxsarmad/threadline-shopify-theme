<div class="collection-page">
  <header class="collection-page__header">
    <p class="collection-page__marker">Collection page......</p>
    <h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="collection-page__description">{{ collection.description }}</div>{% endif %}
    <p class="collection-page__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
  </header>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-grid collection-grid--{{ section.settings.columns_desktop }}">
      {% for product in collection.products %}
        <article class="collection-card">
          <a class="collection-card__media" href="{{ product.url | within: collection }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
            {% unless product.available %}
              <span class="collection-card__badge">Sold out</span>
            {% else %}
              {% if product.compare_at_price > product.price %}<span class="collection-card__badge">Sale</span>{% endif %}
            {% endunless %}
          </a>
          <div class="collection-card__details">
            <h2><a href="{{ product.url | within: collection }}">{{ product.title | escape }}</a></h2>
            <p>
              {% if product.price_varies %}From {% endif %}{{ product.price | money }}
              {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
            </p>
          </div>
        </article>
      {% else %}
        <p class="collection-page__empty">No products are currently available in this collection.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}<nav class="collection-pagination" aria-label="Collection pagination">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-page { padding-block: clamp(3rem,7vw,7rem); }
  .collection-page__header { border-bottom: 1px solid rgba(24,35,28,.16); margin-bottom: 2.5rem; padding-bottom: clamp(2rem,4vw,3.5rem); position: relative; }
  .collection-page__marker { background: #d7653b; color: #fff; display: inline-block; font-size: .65rem; font-weight: 750; letter-spacing: .16em; margin-bottom: 1.25rem; padding: .5rem .7rem; text-transform: uppercase; }
  .collection-page__header h1 { color: #18231c; font-family: Georgia,serif; font-size: clamp(3.2rem,7vw,7rem); font-weight: 400; letter-spacing: -.055em; line-height: .9; max-width: 12ch; }
  .collection-page__description { color: rgba(24,35,28,.68); line-height: 1.7; margin-top: 1.5rem; max-width: 42rem; }
  .collection-page__count { bottom: 3.5rem; font-size: .7rem; font-weight: 700; letter-spacing: .12em; position: absolute; right: 0; text-transform: uppercase; }
  .collection-grid { display: grid; gap: clamp(1rem,2vw,1.75rem); row-gap: clamp(2.5rem,5vw,4rem); }
  .collection-grid--3 { grid-template-columns: repeat(3,1fr); }
  .collection-grid--4 { grid-template-columns: repeat(4,1fr); }
  .collection-card__media { aspect-ratio: 3 / 4; background: #eee8de; display: block; overflow: hidden; position: relative; }
  .collection-card__media img, .collection-card__media svg { height: 100%; object-fit: cover; transition: transform .55s ease; width: 100%; }
  .collection-card:hover .collection-card__media img { transform: scale(1.035); }
  .collection-card__badge { background: #fff; color: #18231c; font-size: .62rem; font-weight: 750; left: .75rem; letter-spacing: .1em; padding: .45rem .6rem; position: absolute; text-transform: uppercase; top: .75rem; }
  .collection-card__details { display: flex; font-size: .85rem; gap: 1rem; justify-content: space-between; padding-top: .9rem; }
  .collection-card__details h2 { font-size: inherit; font-weight: 600; }
  .collection-card__details a { color: inherit; text-decoration: none; }
  .collection-card__details s { color: #888; font-size: .76rem; margin-left: .25rem; }
  .collection-pagination { display: flex; justify-content: center; margin-top: 4rem; }
  .collection-pagination .page, .collection-pagination .next, .collection-pagination .prev { margin: .35rem; }
  .collection-pagination a { color: inherit; }
  .collection-page__empty { grid-column: 1 / -1; padding: 5rem 0; text-align: center; }
  @media (max-width: 749px) {
    .collection-page__count { margin-top: 1.5rem; position: static; }
    .collection-grid--3, .collection-grid--4 { grid-template-columns: repeat(2,1fr); }
    .collection-card__details { display: block; }
    .collection-card__details p { margin-top: .35rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
