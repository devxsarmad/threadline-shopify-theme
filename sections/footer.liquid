<footer class="site-footer full-width">
  <div class="site-footer__inner">
    <div class="site-footer__brand"><a href="{{ routes.root_url }}">{{ shop.name | default: 'THREADLINE' | escape }}</a><p>{{ section.settings.tagline | escape }}</p></div>
    <div><h2>Explore</h2><nav>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav></div>
    <div><h2>Follow</h2><nav>{% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}">Instagram</a>{% endif %}{% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}">TikTok</a>{% endif %}{% if section.settings.pinterest_url != blank %}<a href="{{ section.settings.pinterest_url }}">Pinterest</a>{% endif %}</nav></div>
  </div>
  <div class="site-footer__bottom"><p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. Made to be lived in.</p>{% if section.settings.show_payment_icons %}<div class="site-footer__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}</div>
</footer>
{% stylesheet %}
  .site-footer { background: #18231c; color: #f6f1e8; margin-top: clamp(4rem,8vw,8rem); padding: clamp(3rem,7vw,6rem) var(--page-margin) 1.5rem; }
  .site-footer__inner, .site-footer__bottom { margin: 0 auto; max-width: var(--page-width); }
  .site-footer__inner { display: grid; gap: 3rem; grid-template-columns: 2fr 1fr 1fr; }
  .site-footer__brand > a { color: inherit; font-size: 1.55rem; font-weight: 800; letter-spacing: .18em; text-decoration: none; }
  .site-footer__brand p { color: rgba(255,255,255,.68); line-height: 1.6; margin-top: 1rem; max-width: 25rem; }
  .site-footer h2 { font-size: .72rem; letter-spacing: .16em; margin-bottom: 1rem; text-transform: uppercase; }
  .site-footer nav { display: grid; gap: .7rem; }
  .site-footer nav a { color: rgba(255,255,255,.72); text-decoration: none; width: fit-content; }
  .site-footer nav a:hover { color: #fff; }
  .site-footer__bottom { align-items: center; border-top: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.55); display: flex; font-size: .76rem; justify-content: space-between; margin-top: 4rem; padding-top: 1.5rem; }
  .site-footer__payments { display: flex; flex-wrap: wrap; gap: .4rem; }
  .site-footer__payments svg { height: 1.5rem; width: auto; }
  @media (max-width: 749px) { .site-footer__inner { grid-template-columns: 1fr 1fr; } .site-footer__brand { grid-column: 1 / -1; } .site-footer__bottom { align-items: flex-start; flex-direction: column; gap: 1rem; } }
{% endstylesheet %}
{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Considered essentials for everyday movement, made with a lighter footprint." },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true }
  ]
}
{% endschema %}
