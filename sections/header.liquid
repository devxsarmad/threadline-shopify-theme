<div class="site-header-wrap full-width">
  {% if section.settings.announcement_text != blank %}
    <div class="announcement-bar">
      {% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{% endif %}
        {{ section.settings.announcement_text | escape }}
      {% if section.settings.announcement_link != blank %}</a>{% endif %}
    </div>
  {% endif %}
  <header class="site-header">
    <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 360 | image_tag: widths: '120, 180, 240, 360', width: section.settings.logo_width, loading: 'eager', alt: shop.name }}
      {% else %}<span>{{ shop.name | default: 'THREADLINE' | escape }}</span>{% endif %}
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endfor %}
    </nav>
    <div class="site-header__actions">
      {% if shop.customer_accounts_enabled %}<a class="site-header__icon" href="{{ routes.account_url }}" aria-label="Account">{{ 'icon-account.svg' | inline_asset_content }}</a>{% endif %}
      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
      <details class="mobile-menu">
        <summary aria-label="Open menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav>
      </details>
    </div>
  </header>
</div>

{% stylesheet %}
  .site-header-wrap { background: var(--color-background); border-bottom: 1px solid rgba(24,24,24,.1); position: relative; z-index: 20; }
  .announcement-bar { background: #1d2c22; color: #fff; font-size: .72rem; font-weight: 700; letter-spacing: .14em; padding: .65rem var(--page-margin); text-align: center; text-transform: uppercase; }
  .announcement-bar a { color: inherit; text-decoration: none; }
  .site-header { align-items: center; display: grid; grid-template-columns: 1fr auto 1fr; margin: 0 auto; max-width: var(--page-width); min-height: 5.25rem; padding: 0 var(--page-margin); }
  .site-header__brand { color: var(--color-foreground); font-size: 1.35rem; font-weight: 800; letter-spacing: .18em; text-decoration: none; }
  .site-header__brand img { display: block; max-height: 3rem; object-fit: contain; width: auto; }
  .site-header__nav { display: flex; gap: clamp(1.25rem,3vw,2.5rem); }
  .site-header__nav a { color: var(--color-foreground); font-size: .78rem; font-weight: 650; letter-spacing: .1em; position: relative; text-decoration: none; text-transform: uppercase; }
  .site-header__nav a::after { background: currentColor; bottom: -.45rem; content: ''; height: 1px; left: 0; position: absolute; transform: scaleX(0); transform-origin: right; transition: transform .25s ease; width: 100%; }
  .site-header__nav a:hover::after, .site-header__nav a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .site-header__actions { align-items: center; display: flex; gap: 1rem; justify-content: flex-end; }
  .site-header__icon { color: var(--color-foreground); position: relative; }
  .site-header__icon svg { height: 1.35rem; width: 1.35rem; }
  .cart-count { align-items: center; background: #d7653b; border-radius: 99px; color: #fff; display: flex; font-size: .62rem; height: 1.1rem; justify-content: center; position: absolute; right: -.65rem; top: -.55rem; width: 1.1rem; }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { cursor: pointer; display: grid; gap: 4px; list-style: none; width: 1.5rem; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { background: currentColor; height: 1px; width: 100%; }
  .mobile-menu nav { background: var(--color-background); border: 1px solid rgba(24,24,24,.1); display: grid; min-width: 15rem; padding: 1rem; position: absolute; right: 0; top: 2rem; }
  .mobile-menu nav a { color: inherit; font-weight: 650; padding: .75rem; text-decoration: none; }
  @media (max-width: 749px) { .site-header { grid-template-columns: 1fr auto; min-height: 4.5rem; } .site-header__nav { display: none; } .mobile-menu { display: block; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 150 },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu" },
    { "type": "text", "id": "announcement_text", "label": "Announcement", "default": "Free delivery on orders over $75" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" }
  ]
}
{% endschema %}
